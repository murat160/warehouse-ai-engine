# =============================================================================
# Production environment template — copy to .env.production on the VPS and
# fill in real values. .env.production is gitignored: it must NEVER be
# committed.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano  .env.production
#
# Murat AI is **licence-clean by default**: every backend enabled below is
# released under Apache 2.0, MIT or a commercial API whose output you own.
# Anything Creative Commons NonCommercial is opt-in and clearly labelled.
# Full breakdown: docs/licensing.md
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (used by docker-compose to spin up the DB and to compose DATABASE_URL)
# -----------------------------------------------------------------------------
POSTGRES_USER=murat_ai
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
POSTGRES_DB=murat_ai

# -----------------------------------------------------------------------------
# Translation backend
# -----------------------------------------------------------------------------
# Default: google/madlad400-3b-mt (Apache 2.0, 400+ languages incl. Turkmen).
# To use a different checkpoint (your own fine-tune, OPUS-MT, etc.) override
# here. To opt into facebook/nllb-200-distilled-600M you MUST accept its
# CC-BY-NC 4.0 (non-commercial) terms — see docs/licensing.md.
MURAT_AI_TRANSLATION_MODEL=google/madlad400-3b-mt

# -----------------------------------------------------------------------------
# Cloud TTS / API providers (optional — output of these APIs is owned by you)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# -----------------------------------------------------------------------------
# Turkmen TTS — opt-in
#
# Murat AI does NOT enable any non-commercial TTS by default. To get a
# Turkmen voice pick ONE of:
#
#   1. A commercial cloud TTS (output is yours): OPENAI_API_KEY above,
#      ElevenLabs, Azure Speech, Google Cloud TTS — wire them up via
#      the FastAPI provider chain.
#   2. Your own model trained from Apache 2.0 / MIT data and code.
#   3. ``espeak-ng`` (low-quality robotic fallback, MIT-compatible CLI).
#   4. Opt-in to Meta MMS-TTS by setting MMS_TTS_TUK_ENABLED=true below
#      — that backend is **CC-BY-NC 4.0** (NON-commercial only). Use it
#      ONLY for personal, research or demo deployments.
# -----------------------------------------------------------------------------
MMS_TTS_TUK_ENABLED=false
MMS_TTS_TUK_MODEL=facebook/mms-tts-tuk-script_latin
HF_HOME=/app/hf_cache

# -----------------------------------------------------------------------------
# Translator behaviour
# -----------------------------------------------------------------------------
TRANSLATOR_USE_GLOSSARY=true
TRANSLATOR_QUALITY_CHECK=true
TRANSLATOR_LATENCY_BUDGET=0.3

# -----------------------------------------------------------------------------
# Streamlit hardening
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# -----------------------------------------------------------------------------
# ffmpeg (path inside the container — leave empty to use the bundled one)
# -----------------------------------------------------------------------------
FFMPEG_BINARY=

# -----------------------------------------------------------------------------
# External Turkmen TTS provider (optional). Generic REST adapter.
# Если не заполнено — pipeline использует MMS-TTS fallback.
#
# ElevenLabs example:
#   TURKMEN_TTS_PROVIDER=elevenlabs
#   TURKMEN_TTS_API_BASE_URL=https://api.elevenlabs.io
#   TURKMEN_TTS_API_KEY=sk_xxx
#   TURKMEN_TTS_VOICE_ID=<voice_id>
#   TURKMEN_TTS_ENDPOINT_TEMPLATE=/v1/text-to-speech/{voice_id}
#   TURKMEN_TTS_AUTH_HEADER=xi-api-key
#   TURKMEN_TTS_AUTH_FORMAT={key}
#   TURKMEN_TTS_BODY_TEMPLATE={{"text":{text_json},"model_id":"eleven_multilingual_v2"}}
#   TURKMEN_TTS_RESPONSE_FORMAT=audio
#   TURKMEN_TTS_OUTPUT_FORMAT=mp3
#
# OpenAI TTS example:
#   TURKMEN_TTS_API_BASE_URL=https://api.openai.com
#   TURKMEN_TTS_API_KEY=sk-xxx
#   TURKMEN_TTS_ENDPOINT_TEMPLATE=/v1/audio/speech
#   TURKMEN_TTS_AUTH_HEADER=Authorization
#   TURKMEN_TTS_AUTH_FORMAT=Bearer {key}
#   TURKMEN_TTS_BODY_TEMPLATE={{"model":"tts-1","input":{text_json},"voice":"alloy"}}
# -----------------------------------------------------------------------------
TURKMEN_TTS_PROVIDER=
TURKMEN_TTS_API_BASE_URL=
TURKMEN_TTS_API_KEY=
TURKMEN_TTS_VOICE_ID=
TURKMEN_TTS_ENDPOINT_TEMPLATE=/v1/text-to-speech/{voice_id}
TURKMEN_TTS_AUTH_HEADER=xi-api-key
TURKMEN_TTS_AUTH_FORMAT={key}
TURKMEN_TTS_BODY_TEMPLATE=
TURKMEN_TTS_RESPONSE_FORMAT=audio
TURKMEN_TTS_RESPONSE_URL_FIELD=audio_url
TURKMEN_TTS_OUTPUT_FORMAT=mp3
TURKMEN_TTS_TIMEOUT_SEC=60
