# =============================================================================
# Production environment template — copy to .env.production on the VPS and
# fill in real values. .env.production is gitignored: it must NEVER be
# committed.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano  .env.production
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (used by docker-compose to spin up the DB and to compose DATABASE_URL)
# -----------------------------------------------------------------------------
POSTGRES_USER=warehouse_ai
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
POSTGRES_DB=warehouse_ai

# -----------------------------------------------------------------------------
# Translator / API providers (optional)
# -----------------------------------------------------------------------------
# OpenAI is used by the FastAPI provider chain for ru/tr/en TTS and as one of
# the translation providers. The Streamlit MVP does NOT require it for text
# translation (NLLB-200 runs locally) or for Turkmen voice (MMS-TTS is offline).
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# -----------------------------------------------------------------------------
# Offline Turkmen TTS (Meta MMS-TTS) — keep enabled for high-quality tk voice.
#
# ⚠️ Licence note: MMS-TTS and NLLB-200 are released by Meta under
# CC-BY-NC 4.0 (NON-COMMERCIAL). Personal, research, demo and open-source
# use is fine. If Murat AI moves into a paid SaaS or ad-monetised
# product, swap these backends for commercially-licensed providers —
# see docs/attributions.md for the full breakdown.
# -----------------------------------------------------------------------------
MMS_TTS_TUK_ENABLED=true
MMS_TTS_TUK_MODEL=facebook/mms-tts-tuk-script_latin
HF_HOME=/app/hf_cache

# -----------------------------------------------------------------------------
# Translator behaviour
# -----------------------------------------------------------------------------
TRANSLATOR_USE_GLOSSARY=true
TRANSLATOR_QUALITY_CHECK=true
TRANSLATOR_LATENCY_BUDGET=0.3

# -----------------------------------------------------------------------------
# Streamlit hardening
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# -----------------------------------------------------------------------------
# ffmpeg (path inside the container — leave empty to use the bundled one)
# -----------------------------------------------------------------------------
FFMPEG_BINARY=
