# Copy this file to .env and fill the values.
# DO NOT commit your real .env to git.

# --- Primary translation / STT / TTS provider ---
# OpenAI is used for high-quality translation (gpt-4o-class models),
# speech-to-text (whisper-1) and text-to-speech (tts-1 / tts-1-hd).
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Fallback / offline TTS for Turkmen (Meta MMS) ---
# https://huggingface.co/facebook/mms-tts-tuk-script_latin
# When ENABLED=true the fallback provider will load the local Vits model.
MMS_TTS_TUK_ENABLED=false
MMS_TTS_TUK_MODEL=facebook/mms-tts-tuk-script_latin
HF_HOME=./hf_cache

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=*

# --- Translator behaviour ---
# Enforce literary register and apply ru<->tk glossary post-processing.
TRANSLATOR_USE_GLOSSARY=true
TRANSLATOR_QUALITY_CHECK=true
# Soft latency budget per request in seconds (used only as a metric).
TRANSLATOR_LATENCY_BUDGET=0.3

# --- ffmpeg ---
# Path to ffmpeg binary, leave empty to use the one from PATH.
FFMPEG_BINARY=
